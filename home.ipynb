   "source": [
    "## Find The Prime Number\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "c4d35f9b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "4\n",
      "Not a Prime Number\n"
     ]
    }
   ],
   "source": [
    "num1= int(input(\"enter the prime number\"))\n",
    "print(num1)\n",
    "count = 0\n",
    "\n",
    "for i in range(1, num1 + 1):\n",
    "    if num1 % i == 0:\n",
    "        count = count + 1\n",
    "\n",
    "if count == 2:\n",
    "    print(\"Prime Number\")\n",
    "else:\n",
    "    print(\"Not a Prime Number\")"
   ]
  }
